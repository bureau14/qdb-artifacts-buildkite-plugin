#!/usr/bin/env python3
"""A generator laid out as the real ones are.

The shared library is a git submodule next to this file, so its directory
goes on sys.path before the import, which then carries a noqa comment.

Usage:
    python3 pipeline.py [generate|check]
"""

from __future__ import annotations

import sys
from pathlib import Path

from buildkite_sdk import CommandStep, Pipeline

sys.path.insert(0, str(Path(__file__).parent / "tools"))
from qdb_pipeline import (  # noqa: E402
    get_git_ref,
    load_template,
    run,
    select_platforms,
    set_artifact_plugin_options,
)

STEPS_DIR = Path(__file__).parent / "steps"
PLATFORMS = select_platforms("linux-amd64-core2", "windows-amd64-core2")


def _build_step(platform) -> dict:
    step = load_template(STEPS_DIR / "_build.yml", slug=platform.slug())
    set_artifact_plugin_options(step, {"upload": {"git_ref": get_git_ref()}})
    return step


def generate_pipeline() -> Pipeline:
    pipeline = Pipeline()
    for platform in PLATFORMS:
        pipeline.add_step(CommandStep.from_dict(_build_step(platform)))
    return pipeline


if __name__ == "__main__":
    run(generate_pipeline)
