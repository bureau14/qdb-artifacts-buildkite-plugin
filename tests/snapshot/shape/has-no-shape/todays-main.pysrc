# A generator that has not adopted: it carries its own main().
import sys

from qdb_pipeline import validate_pipeline


def generate_pipeline():
    return None


def main() -> None:
    command = sys.argv[1] if len(sys.argv) > 1 else "generate"
    pipeline = generate_pipeline()
    if command == "check":
        print(validate_pipeline(pipeline))
    else:
        print(pipeline)


if __name__ == "__main__":
    main()
