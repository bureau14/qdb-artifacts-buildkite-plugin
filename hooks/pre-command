#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

# Leave without starting Python when the step downloads, uploads and promotes
# nothing. A step that uploads or promotes has its step id checked here, before
# its command, and an upload block without files fails here too.
if ! plugin_has_any DOWNLOAD_PROJECTS_0_VARIANT PROMOTE_VARIANT && ! plugin_has_block UPLOAD; then
  exit 0
fi

run_artifacts_py pre-command

