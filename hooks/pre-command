#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

# Leave without starting Python when the step downloads nothing.
if ! plugin_has_any DOWNLOAD_PROJECTS_0_VARIANT; then
  exit 0
fi

run_artifacts_py pre-command

