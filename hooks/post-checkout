#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

echo "~~~ :python: Setting up qdb-artifacts plugin"

PYTHON="$(agent_python)"
VERSION="$(python_version "${PYTHON}")"
if [[ -z "${VERSION}" ]]; then
  echo "+++ :rotating_light: qdb-artifacts plugin finds no Python that runs"
  echo "It runs the Python the agent names in QDB_CICD_AGENT_PLUGIN_PYTHON:"
  echo "QDB_CICD_AGENT_PLUGIN_PYTHON=${QDB_CICD_AGENT_PLUGIN_PYTHON:-}"
  exit 1
fi
echo "Python ${VERSION} at ${PYTHON}"

REQUIREMENTS=(-r "${PLUGIN_DIR}/lib/requirements.txt")
if step_reads_documents; then
  REQUIREMENTS+=(-r "${PLUGIN_DIR}/lib/snapshot/requirements.txt")
fi

if [[ -d "${VENV_DIR}" ]]; then
  rm -rf "${VENV_DIR}"
fi

"${PYTHON}" -m venv --upgrade-deps "${VENV_DIR}"
"${VENV_BIN}/python" -m pip install --quiet \
  --retries 3 --resume-retries 3 \
  "${REQUIREMENTS[@]}"
