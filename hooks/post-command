#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

# Leave without starting Python when the step asks for nothing after its
# command. PLAN, PLAN_AGAIN and LAST_STEP are set only on the plan step, its
# second run and the last step. Any option of the upload block starts Python,
# which fails a block that names no files.
if ! plugin_has_any PROMOTE_VARIANT PLAN PLAN_AGAIN LAST_STEP && ! plugin_has_block UPLOAD; then
  echo "No upload or promote configuration found, skipping artifact upload/promote steps"
  exit 0
fi

run_artifacts_py post-command
