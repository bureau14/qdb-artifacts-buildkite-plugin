#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

# Exit early if neither upload nor promote is configured
if [[ -z "${BUILDKITE_PLUGIN_QDB_ARTIFACTS_UPLOAD_FILES_0:-}" ]] && [[ -z "${BUILDKITE_PLUGIN_QDB_ARTIFACTS_UPLOAD_FILES:-}" ]] && [[ -z "${BUILDKITE_PLUGIN_QDB_ARTIFACTS_PROMOTE_VARIANT:-}" ]]; then
  echo "No upload or promote configuration found, skipping artifact upload/promote steps"
  exit 0
fi

command_exit_status="${BUILDKITE_COMMAND_EXIT_STATUS:-0}"

# First upload files if env var for upload is set, if env var for promote is configured as well run that after upload

if [[ -n "${BUILDKITE_PLUGIN_QDB_ARTIFACTS_UPLOAD_FILES_0:-}" ]] || [[ -n "${BUILDKITE_PLUGIN_QDB_ARTIFACTS_UPLOAD_FILES:-}" ]]; then
  echo "~~~ :arrow_up: Uploading artifacts"
  run_artifacts_py upload
fi

if [[ -n "${BUILDKITE_PLUGIN_QDB_ARTIFACTS_PROMOTE_VARIANT:-}" ]]; then
  if [[ "${command_exit_status}" -ne 0 ]]; then
    echo "~~~ :warning: Skipping artifact promotion (command exited ${command_exit_status})"
  else
    echo "~~~ :pushpin: Promoting artifacts"

    args=(promote)

    # --project-id
    project_id="$(plugin_read_config PROMOTE_PROJECT_ID "")"
    [[ -n "${project_id}" ]] && args+=(--project-id "${project_id}")

    # --build-id
    build_id="$(plugin_read_config PROMOTE_BUILD_ID "")"
    [[ -n "${build_id}" ]] && args+=(--build-id "${build_id}")

    # --git-ref
    git_ref="$(plugin_read_config PROMOTE_GIT_REF "")"
    [[ -n "${git_ref}" ]] && args+=(--git-ref "${git_ref}")

    # --variant
    variant="$(plugin_read_config PROMOTE_VARIANT "")"
    [[ -n "${variant}" ]] && args+=(--variant "${variant}")

    run_artifacts_py "${args[@]}"
  fi
fi
